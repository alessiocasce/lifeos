# Frontend public Supabase config. Safe for Vite/browser use.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only API config. Never expose these with a VITE_ prefix.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only
LIFEOS_ACTION_TOKEN=generate-a-long-random-token
LIFEOS_ACTION_USER_ID=target-supabase-auth-user-uuid
GEMINI_API_KEY=your-gemini-api-key-server-only
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Jarvis Companion (docs/specs/jarvis-companion.md). Server-only.
ANTHROPIC_API_KEY=your-anthropic-api-key-server-only
# Capabilities stay off unless set to true.
COMPANION_AGENT=false
COMPANION_PROACTIVE=false
COMPANION_CALLS=false
COMPANION_EMAIL=false
# Optional model overrides as provider:model[@effort].
# COMPANION_MODEL_FAST=gemini:gemini-3.8-flash
# COMPANION_MODEL_DEEP=gemini:gemini-3.8-flash@high
# Optional budget settings for the spend guard.
# COMPANION_MONTHLY_BUDGET_EUR=30
# COMPANION_USD_PER_EUR=1.15
# COMPANION_FIXED_MONTHLY_USD=6
